# secrets
.env
.env.*
!.env.example

# runtime
maker.db
maker.db-*
hunter.db
hunter.db-*
# live fleet state: a 2MB binary that churns every sweep, plus the state
# snapshot the dashboard reads. Both are run output, not source.
# run/markets.json (fleet input) and run/live_test_*.json (pre-registered
# predictions) are deliberately NOT ignored -- they are source of truth.
run/*.db
run/*.db-*
run/*.db.bak-*
run/fleet_state.json
run/live_orders.json
# ranker output, same class as fleet_state.json above. near_misses.jsonl is
# appended once per rank -- at a 600s rerank interval that is 144 lines/day,
# each embedding every green card of that pass -- and pipeline.json is
# rewritten whole on every rank. Both are telemetry the dashboard reads, not
# source, and neither survives a checkout in any useful form.
run/near_misses.jsonl
run/volume_near_misses.jsonl
run/pipeline.json
run/trial_depth_report.json
run/live_poll_heartbeat.json
run/oscillation_*.jsonl
run/oscillation_*.json
# recorded market data + backfilled tape (scripts/record_books.py,
# scripts/fetch_trades.py). Regenerable, and large after a long run.
books.db
books.db-*
*.pid
logs/
# `archive/` holds two flavours of content: runtime DB snapshots
# (archive/20260729/, archive/20260730-... -- regenerated by runs and
# deliberately NOT source), and one source-code archive, the historical
# 8788 single-bot pipeline captured in `archive/legacy-bot-8788/`. The
# latter is git-tracked so the dead version is recoverable; the rest of
# archive/ stays gitignored runtime data.
archive/*
!archive/legacy-bot-8788/
!archive/legacy-bot-8788/**
# The i-have-adhd skill is tracked once, at .agents/skills/i-have-adhd/, which
# is the path AGENTS.md cites. Its .claude/ twin is a symlink to an ABSOLUTE
# path on the machine that installed it, so committing it would store one
# developer's home directory and resolve nowhere else.
.claude/skills/i-have-adhd

# ECC (Extended Claude Capabilities) plugin output — auto-generated instincts,
# identity profiles, tool manifests, and Codex configs. All superseded by
# AGENTS.md and provide no value to this repo.
.claude/homunculus/
.claude/ecc-tools.json
.claude/identity.json
.codex/

# A separate 28MB React/Bun/Convex project that happens to live inside this
# directory. It was recorded as a gitlink (mode 160000 -> 69f925a6) with no
# .gitmodules entry, so git tracked a submodule pointer to a repository it had
# no URL for -- a clone of this repo could never resolve it. The pointer is gone
# as of 2026-08-16; the files are left untouched on disk and simply ignored.
spread-hunter/

# python
.venv/
__pycache__/
*.pyc

# Freebuff Desktop app data -- local, never commit
.freebuff/

# run/ is the live fleet's working directory: SQLite databases it writes
# continuously, their journals, archived snapshots of both, and the ranked
# universe the rerank loop rewrites every cycle. All of it is regenerated
# output, not source.
run/*.db
run/*.db-journal
run/*.db-wal
run/*.db-shm
# Generated SQLite at ANY depth under run/ (e.g. bankroll_100/fleet.db from the
# experiment harness). A bare `run/*.db` only matches the root level; `**`
# crosses subdirs. Intentional sources of truth (run/markets.json,
# run/live_test_*.json) are JSON and stay tracked — do not add run/**/*.json.
run/**/*.db
run/**/*.db-*
run/**/*.db.bak-*
run/**/*.db-journal
run/**/*.db-wal
run/**/*.db-shm
# Supervisor and dashboard stdout/stderr. Four of these were tracked until
# 2026-08-16 (1,033 KB, mostly supervisor.log), which AGENTS.md's hygiene rule
# already forbade: "Never commit generated output or debug logs." Untracked with
# `git rm --cached` rather than deleted, because the fleet writes to them live.
run/*.log
run/archive/
run/markets.json
run/fleet_state.json
# Which PIDs this checkout started, so shutdown stops its own fleet rather
# than every fleet-shaped process on the machine. Per-machine, per-run.
run/*.pids.json
run/fleet.pids.json
run/fleet_pulse.json
run/ranking.marker
.gstack/

# Temporary diagnostic dumps & tool state files
.buffy-state*
diagrams/
run/*.txt
run/bankroll_*/
.superpowers/
# One-off analysis scripts written against run/fleet.db. AGENTS.md requires
# these be deleted once their output is verified; ignoring the directory means
# a forgotten one can never reach a commit in the meantime.
scratch/

# Live extraction runtime state (live/run/*.db, *.log, *.json)
live/run/
**/run/*.db
**/run/*.db-*
**/run/*.db.bak-*
**/run/*.db-journal
**/run/*.db-wal
**/run/*.db-shm
**/run/*.log
